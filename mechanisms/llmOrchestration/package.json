{
  "name": "advanced-llm-orchestrator",
  "version": "1.0.0",
  "description": "Advanced LLM Orchestration System with intelligent caching, prompt evolution, and multi-provider support",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "ts-node server.ts",
    "dev:worker": "ts-node worker.ts",
    "demo": "ts-node -e \"import('./orchestrator').then(m => m.runAdvancedDemo())\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postbuild": "cp package.json dist/",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "forever:start": "forever start dist/server.js",
    "forever:stop": "forever stop dist/server.js",
    "forever:list": "forever list",
    "docker:build": "docker build -t advanced-llm-orchestrator .",
    "docker:run": "docker run -p 3000:3000 advanced-llm-orchestrator",
    "deploy:production": "pm2 deploy production",
    "deploy:staging": "pm2 deploy staging"
  },
  "keywords": [
    "llm",
    "orchestration",
    "ai",
    "prompt-engineering",
    "multi-provider",
    "caching",
    "evolution",
    "serverless",
    "microservices"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "ws": "^8.14.2",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/jest": "^29.5.8",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/advanced-llm-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/advanced-llm-orchestrator/issues"
  },
  "homepage": "https://github.com/yourusername/advanced-llm-orchestrator#readme"
}