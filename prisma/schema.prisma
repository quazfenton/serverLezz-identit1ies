// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  avatar    String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  
  // Location
  latitude  Float?
  longitude Float?
  city      String?
  country   String?
  
  // Resources (stored as JSON)
  resources Json?
  
  // Economic profile (stored as JSON)
  economicProfile Json?
  
  // Behavior profile (stored as JSON)
  behaviorProfile Json?
  
  // Reputation (stored as JSON)
  reputation Json?
  
  // Weight for matching
  weight Float @default(0.5)
  
  // Tags (stored as JSON array)
  tags Json?
  
  // Relationships
  listings    Listing[]
  connections Connection[] @relation("ProfileConnections")
  sessions    Session[]
  
  @@map("profiles")
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String   // 'offer' | 'request'
  category    String?
  status      String   @default("active") // 'active' | 'inactive' | 'deleted'
  
  // Provider
  providerId String
  provider   Profile @relation(fields: [providerId], references: [id])
  
  // Location
  latitude  Float?
  longitude Float?
  city      String?
  country   String?
  remote    Boolean  @default(false)
  
  // Pricing (stored as JSON)
  pricing Json?
  
  // Availability (stored as JSON)
  availability Json?
  
  // Requirements (stored as JSON)
  requirements Json?
  
  // Quality metrics (stored as JSON)
  qualityMetrics Json?
  
  // Tags (stored as JSON array)
  tags Json?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  viewCount Int      @default(0)
  rating    Float    @default(0)
  reviewCount Int    @default(0)
  
  @@map("listings")
}

model Connection {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  strength  Float    @default(0.5)
  status    String   @default("pending") // 'pending' | 'accepted' | 'rejected'
  message   String?
  
  // Relationships
  fromProfile Profile @relation("ProfileConnections", fields: [fromId], references: [id])
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Interactions (stored as JSON array)
  interactions Json?
  
  @@unique([fromId, toId])
  @@map("connections")
}

model Session {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])
  createdAt DateTime @default(now())
  
  @@map("sessions")
}

model SystemMetrics {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  totalUsers        Int      @default(0)
  activeUsers       Int      @default(0)
  totalListings     Int      @default(0)
  activeListings    Int      @default(0)
  successfulMatches Int      @default(0)
  totalUtility      Float    @default(0)
  wasteLevel        Float    @default(0)
  efficiencyScore   Float    @default(0)
  equityIndex       Float    @default(0)
  socialWelfare     Float    @default(0)
  coordinationCost  Float    @default(0)
  networkHealth     Float    @default(0)
  adaptationSpeed   Float    @default(0)
  
  @@map("system_metrics")
}
